# Copy to .env and adjust. All vars use the ORCA_ prefix.
ORCA_DEBUG=false
ORCA_LOG_LEVEL=INFO
# Comma-separated or JSON origins, e.g. ["*"]
ORCA_CORS_ORIGINS=["*"]


# Behaviour
ORCA_DEMO_MODE=true
ORCA_DEMO_FALLBACK=true
ORCA_RESTRICT_TO_INDIA=true
ORCA_RATE_LIMIT_PER_MINUTE=60
ORCA_REQUEST_TIMEOUT_SECONDS=8

# Cache TTLs
ORCA_CACHE_TTL_WEATHER_SECONDS=600
ORCA_CACHE_TTL_OCEAN_SECONDS=900
ORCA_CACHE_TTL_WARNINGS_SECONDS=1800

# IMD adapter (fill when M2 finalises access; until then Open-Meteo is used)
# ORCA_IMD_API_BASE_URL=https://example-imd-endpoint
# ORCA_IMD_API_KEY=your-key

# Optional guardrailed LLM explanation layer (OpenAI-compatible)
# ORCA_LLM_API_KEY=sk-...
# ORCA_LLM_BASE_URL=https://api.openai.com/v1
# ORCA_LLM_MODEL=gpt-4o-mini