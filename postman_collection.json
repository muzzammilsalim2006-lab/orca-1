{
  "info": {
    "name": "ORCA Marine Safety & Risk API",
    "description": "API collection for ORCA - AI-assisted marine intelligence & coastal safety platform for SIH 2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Metadata & Thresholds",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/meta"
      }
    },
    {
      "name": "Demo Locations List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/demo/locations"
      }
    },
    {
      "name": "Assess Risk - Demo Mode (Chennai)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/assess",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 13.0827,\n  \"longitude\": 80.2707,\n  \"label\": \"Chennai Coast\",\n  \"demo\": true,\n  \"include_explanation\": true\n}"
        }
      }
    },
    {
      "name": "Assess Risk - Cyclone Warning Demo (Kochi)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/assess",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 9.9312,\n  \"longitude\": 76.2673,\n  \"label\": \"Kochi Port\",\n  \"demo\": true,\n  \"include_explanation\": true\n}"
        }
      }
    },
    {
      "name": "Assess Risk - Live Data Mode",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/assess",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 13.0827,\n  \"longitude\": 80.2707,\n  \"label\": \"Chennai Live\",\n  \"demo\": false,\n  \"include_explanation\": true\n}"
        }
      }
    }
  ]
}